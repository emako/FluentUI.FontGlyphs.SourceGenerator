<Window x:Class="FluentUI.FontGlyphs.SourceGenerator.Examples.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:FluentUI.FontGlyphs.SourceGenerator.Examples.Wpf"
        Title="FluentUI.FontGlyphs.SourceGenerator WPF"
        Height="280"
        Width="480"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="32">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="图标字体常量" />
        <TextBlock Margin="0,16,0,0"
                   FontFamily="pack://application:,,,/Assets/fontawesome.ttf#FontAwesome"
                   FontSize="72"
                   Text="{x:Static icons:Icons.Heart}" />
        <TextBlock Margin="0,8,0,0"
                   Foreground="#666"
                   Text="Icons.Heart 来自字形名 heart。" />
    </StackPanel>
</Window>
